# Continuity brains (/c). Without these, production shows "not switched on" and stores nothing.
# Supabase project → Settings → API. The service-role key is used only on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Development/testing only: keep brains in process memory (lost on restart).
# CONTINUITY_STORE=memory
