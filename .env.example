# Pearls — environment. Only these matter.

# Clone storage (CLONE YOUR AI). Set automatically on Vercel when the Blob store
# "pearls-clones" (private) is connected to the project. Server-only; never exposed.
BLOB_READ_WRITE_TOKEN=

# Local development / end-to-end tests without Blob: keep clones in server memory.
# Never used silently in production; set it explicitly.
# CLONE_STORE=memory

# Optional: real AI help in Pearls (Claude Haiku 5.5 shapes, Claude Sonnet 5.5 grows).
# Server-only: add it on Vercel as a Sensitive variable; it never reaches the browser.
# Without it, Pearls still works: people make Pearls from their own words, and the site says AI is off.
# ANTHROPIC_API_KEY=
# Turn AI help off without removing the key.
# PEARLS_AI=off
# Key for sealing model contributions (so a Pearl can show "recorded by Pearls").
# Optional: if unset, a key is derived from ANTHROPIC_API_KEY (changing that key makes older seals unverifiable).
# PEARLS_SEAL_KEY=
# Hard spending ceiling for those visits, in US$ (can lower, never raise, the built-in 4.50).
# ANTHROPIC_BUDGET_USD=4.5

# Optional: the Pearl Runtime Substrate (akadaan310/pearl-substrate), https only.
# Unset on this deployment; see docs/v6/BACKEND_CONTRACT_GAPS.md (G1).
# PEARL_SUBSTRATE_URL=

# Optional: continuity brains (/c). Without these, production shows "not switched on" and stores nothing.
# Supabase project → Settings → API. The service-role key is used only on the server. Unused by CLONE YOUR AI.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Development/testing only: keep brains in process memory (lost on restart).
# CONTINUITY_STORE=memory
